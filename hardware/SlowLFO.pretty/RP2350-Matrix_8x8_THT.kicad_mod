(footprint "RP2350-Matrix_8x8_THT"
  (layer "F.Cu")
  (descr "Waveshare RP2350-Matrix 25x25mm 8x8 LED module, 20 edge THT pins, USB-C at top/rear")
  (property "Reference" "U1" (at 0 0 0) (layer "F.SilkS") (effects (font (size 0.85 0.85) (thickness 0.12))))
  (property "Value" "RP2350-Matrix" (at 0 14 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (attr through_hole exclude_from_pos_files)
  (fp_rect (start -12.5 -12.5) (end 12.5 12.5) (stroke (width 0.12) (type solid)) (fill no) (layer "F.Fab"))
  (fp_rect (start -12.75 -12.75) (end 12.75 12.75) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
  (fp_text user "USB-C ↑  5V LEFT" (at 0 -14 0) (layer "F.Fab") (effects (font (size 0.7 0.7) (thickness 0.12))))
  (fp_text user "RP2350 8x8 / 20 THT" (at 0 0 0) (layer "Cmts.User") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (pad "1" thru_hole rect (at -11.43 -11.43) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
